OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# Optional answer-generation deadlines (seconds). Complex questions and
# explicitly selected reasoning modes receive longer budgets by default.
ANSWER_GENERATION_TIMEOUT_SECONDS=180
ANSWER_GENERATION_COMPLEX_TIMEOUT_SECONDS=300
ANSWER_GENERATION_REASONING_TIMEOUT_SECONDS=600
# Safe default for the UI's automatic Thinking choice during strict JSON
# generation. Set to auto to delegate to the provider, or low/medium/high/xhigh.
ANSWER_GENERATION_AUTO_THINKING_MODE=disabled
# Automatic tasks escalate only a failed complex-answer retry to this level.
ANSWER_GENERATION_COMPLEX_RETRY_THINKING_MODE=low

# Bounded unattended quality profile. The default performs at most one
# selective-review batch, one request attempt for that batch, and one semantic
# repair round. Extra transport retries, provider fallbacks, and the duplicate
# post-content review are opt-in and are reported as real model calls.
QUALITY_MAX_SELECTIVE_REVIEW_CANDIDATES=8
QUALITY_MAX_SELECTIVE_REVIEW_BATCHES=1
QUALITY_MAX_SELECTIVE_REVIEW_ATTEMPTS_PER_BATCH=1
QUALITY_MAX_SELECTIVE_REVIEW_PROVIDER_FALLBACKS=0
QUALITY_MAX_PREFIGURE_CORRECTNESS_REPAIR_ROUNDS=1
QUALITY_MAX_ANSWER_GENERATION_REPAIR_ROUNDS=1
QUALITY_ENABLE_POST_CONTENT_SELECTIVE_REVIEW=0
