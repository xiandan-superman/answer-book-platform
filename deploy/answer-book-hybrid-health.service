[Unit]
Description=Answer Book hybrid cloud proactive health check
After=answer-book-hybrid.service

[Service]
Type=oneshot
User=answerbook-hybrid
Group=answerbook-hybrid
WorkingDirectory=/opt/answer-book-platform
EnvironmentFile=/etc/answer-book-hybrid.env
ExecStart=/opt/answer-book-platform/.venv/bin/python scripts/hybrid_cloud_healthcheck.py --url ${ANSWER_BOOK_HYBRID_HEALTH_URL} --tokens /etc/answer-book-hybrid-tokens.json --output /var/lib/answer-book-hybrid/health/latest.json
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/answer-book-hybrid/health
