{
  "schema_version": "answer_book.open_source_components.v1",
  "mineru": {
    "enabled": true,
    "version": "3.4.5",
    "fallback": false
  },
  "structured_output": {
    "pydantic": true,
    "instructor": true,
    "max_validation_retries": 1
  },
  "math_validation": {
    "isolated_process": true,
    "timeout_seconds": 8
  },
  "litellm_shadow": {
    "enabled": true,
    "providers": [
      "lingsuan_openai",
      "lingsuan_google",
      "lingsuan_xai",
      "lingsuan_anthropic"
    ],
    "sample_rate": 0.1,
    "max_pending": 4,
    "max_workers": 1
  }
}
